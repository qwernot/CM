ARG TARGETARCH
FROM debian:bookworm-slim
ARG TARGETARCH
COPY bin/cmsingbox-linux-${TARGETARCH} /usr/local/bin/cmsingbox
COPY bin/sing-box-linux-${TARGETARCH} /usr/local/libexec/sing-box
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates nftables iproute2 tzdata \
    && rm -rf /var/lib/apt/lists/*
VOLUME ["/data"]
EXPOSE 9092/tcp 9090/tcp 2080/tcp 53/tcp 53/udp
ENTRYPOINT ["/bin/sh", "-c", "mkdir -p /data/bin; if [ ! -x /data/bin/sing-box ]; then cp /usr/local/libexec/sing-box /data/bin/sing-box; chmod 0755 /data/bin/sing-box; fi; exec /usr/local/bin/cmsingbox -data /data -port 9092"]
